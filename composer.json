    "ext-fileinfo": "*",
    "ext-iconv": "*",
    "ext-pgsql": "*",
    "vlucas/phpdotenv": "^5.6"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
