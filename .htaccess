<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule (^|/)\. - [F,L]
  RewriteRule ^(?:\.env(?:[./-]|$)|\.git(?:/|$)|application(?:/|$)|vendor(?:/|$)|migrations(?:/|$)|node_modules(?:/|$)|src(?:/|$)|dist(?:/|$)|composer\.(?:json|lock)$|package(?:-lock)?\.json$|README\.md$) - [F,L,NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [QSA,L]
</IfModule>
